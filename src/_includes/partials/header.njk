{% set navItems = [
  { label: "Início", url: "/" },
  { label: "Portfólio", url: "/portfolio/" },
  { label: "Sobre", url: "/sobre/" },
  { label: "Contato", url: "/contato/" }
] %}
<header
  class="site-header{% if heroPage %} over-hero{% endif %}"
  data-hero="{{ 'true' if heroPage else 'false' }}"
>
  <div class="container">
    <a href="/" class="brand" aria-label="{{ site.name }} — página inicial">
      <span class="brand__mark">WM</span>
      <span class="brand__sub">Arquitetura&nbsp;&amp;&nbsp;Design</span>
    </a>

    <nav class="nav" id="site-nav" aria-label="Navegação principal">
      {% for item in navItems %}
        <a
          href="{{ item.url }}"
          class="nav__link"
          {% if page.url == item.url %}aria-current="page"{% endif %}
          >{{ item.label }}</a
        >
      {% endfor %}
      <a href="/contato/" class="nav__cta">Solicitar orçamento</a>
    </nav>

    <button
      class="nav-toggle"
      id="nav-toggle"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <line x1="3" y1="7" x2="21" y2="7" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="17" x2="21" y2="17" />
      </svg>
    </button>
  </div>
</header>
